{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动四季花境",
      "type": "process",
      "command": "${env:ComSpec}",
      "args": ["/d", "/c", "scripts\\node.cmd", "serve.mjs"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "检查手势交互",
      "type": "process",
      "command": "${env:ComSpec}",
      "args": ["/d", "/c", "scripts\\node.cmd", "tests\\core.test.mjs"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
